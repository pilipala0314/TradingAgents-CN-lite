# Git attributes — 控制 diff / 合并 / 检出行为

# ── 文本规范化：所有文本文件 checkout = LF，commit = LF ──
# （Windows 用户即使 IDE 默认 CRLF，git 也会存 LF）
* text=auto eol=lf

# Python 源文件：显式 LF
*.py text eol=lf
*.pyi text eol=lf
*.pyx text eol=lf

# 文档 / 配置
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.sh text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf

# ── 二进制（不要做 line-ending 处理） ──
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar.gz binary
*.whl binary
*.egg-info binary

# ── Markdown 文档：截图 diff 友好 ──
*.md diff=markdown

# ── 导出 diff 时排除（避免大文件） ──
*.csv -diff merge=union
*.parquet binary
*.pkl binary
