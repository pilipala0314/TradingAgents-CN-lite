# Docker 构建忽略 — 避免无关文件入镜像，减小体积

# ── Git / 版本控制 ──
.git/
.gitattributes
.gitignore

# ── Python 缓存 / 测试产物 ──
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml
.tox/
.cache/

# ── 虚拟环境 ──
.venv/
venv/
env/
ENV/

# ── 文档 / 示例（不参与运行时） ──
docs/
examples/
*.md
!README.md
!CHANGELOG.md
!CONTRIBUTING.md
!LICENSE

# ── IDE / 编辑器 ──
.idea/
.vscode/
.DS_Store
*.swp
*.swo

# ── 本地数据 / 密钥 ──
.env
*.local
.env.*
!.env.example
data/raw/
data/cache/
logs/
*.log

# ── 打包产物 ──
build/
dist/
*.egg-info/
*.egg
.eggs/

# ── Alembic（容器启动时跑迁移，不是构建时） ──
# （注：实际项目需要 alembic/ 入镜像，因为 alembic.ini + env.py + versions/ 都要用）
# 如果只构建 API 镜像（不跑迁移），可以加这一行：
# alembic/
