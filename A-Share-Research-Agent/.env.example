# ╔══════════════════════════════════════════════════════════════════════╗
# ║  A-Share Research Agent — 环境变量样例                                ║
# ║  复制为 .env 并按需填入真实值，**不要提交 .env 到 git**                 ║
# ╚══════════════════════════════════════════════════════════════════════╝

# ───────── 基础 ─────────
PROJECT_NAME=A-Share Research Agent
VERSION=0.2.0
ENV=dev                  # dev / staging / prod
LOG_LEVEL=INFO           # DEBUG / INFO / WARNING / ERROR

# ───────── PostgreSQL ─────────
# Docker 内部用 postgres:5432
# 宿主机直连用 host.docker.internal:5432
POSTGRES_DB=ashare_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=please_change_me
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:please_change_me@postgres:5432/ashare_agent

# ───────── Redis ─────────
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ───────── API ─────────
API_PORT=8765
# CORS（开发期放开；生产请指定具体 origin）
CORS_ALLOW_ORIGINS=*

# ───────── DataRouter ─────────
# 路由层配置（与 pyproject.toml 默认值对齐）
ROUTE_DEFAULT_TIMEOUT=10.0     # 单 provider 端点超时（秒）
ROUTE_DEFAULT_STRICT=false      # true=任一失败抛错；false=全部失败才抛
ROUTE_CACHE_TTL_SEC=30          # TTL 缓存（秒），0=关闭
# 是否启用 EXTENDED method_table（财报三表/分钟线/高级事件/个股龙虎榜）
ROUTE_INCLUDE_EXTENDED=false

# ───────── 抓取（EastMoney 反爬补丁） ─────────
EM_MIN_INTERVAL_SEC=0.5         # 同一域名最小请求间隔（秒）
EM_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
EM_RETRY_COUNT=3
EM_RETRY_DELAY_SECONDS=0.5

# ───────── AkShare ─────────
AKSHARE_CONCURRENCY=4
AKSHARE_RETRY_COUNT=3
AKSHARE_RETRY_DELAY_SECONDS=1.5

# ───────── TDX（mootdx） ─────────
# 默认连接池，多个 IP 任选可达即可
TDX_SERVERS=stock.data.gagaup.com,stock.api.mars-stock.com,stock.eastmoney.com

# ───────── LLM ─────────
# provider 可选：openai / deepseek / qwen / qwen-cn / glm / glm-cn /
#                MiniMax / MiniMax-cn / openrouter / ollama / xai
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_API_BASE=
LLM_MODEL_NAME=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_SEC=30

# 兼容各 provider 的子账号配置（留空则使用 LLM_API_KEY）
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
DEEPSEEK_MODEL_NAME=deepseek-chat
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# ───────── Feature / Rule / Output 版本 ─────────
# ETL 写库与规则引擎用，跨 schema 升级时递增
DEFAULT_FEATURE_VERSION=1
DEFAULT_RULE_VERSION=1
DEFAULT_OUTPUT_VERSION=1

# ───────── 日志 / 监控 ─────────
# 关闭特定模块的 DEBUG（按需）
LOG_QUIET_MODULES=urllib3.connectionpool,asyncio

# ───────── Feature Flag ─────────
# 按需开关
ENABLE_FALLBACK_TO_BASELINE=true   # LLM 不可用时降级到规则 baseline
ENABLE_BLOCK_TRADE_INGEST=true
